# Firebase Functions v2 parameterized / dotenv config.
# Copy to `.env` and/or `.env.grid-drive` (project id), then REDEPLOY functions.
#
# createDevDailyReward stays DISABLED unless this is exactly true.
# Default / production: false or omit.
#
# Enable (smoke test only):
#   ALLOW_DEV_DAILY_REWARDS=true
#   firebase deploy --only functions:createDevDailyReward --project grid-drive
#
# Disable after smoke test:
#   ALLOW_DEV_DAILY_REWARDS=false
#   firebase deploy --only functions:createDevDailyReward --project grid-drive
#
# Emulator: gate is always open (FUNCTIONS_EMULATOR=true); .env not required.
ALLOW_DEV_DAILY_REWARDS=false
